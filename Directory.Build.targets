<Project>
  <!-- WPF projects drop System.IO from implicit usings; restore it after the SDK has run. -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>
  <!-- Native engine, FFmpeg, whisper.cpp and tools are copied next to the app and test binaries. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Cutroom.App' or '$(MSBuildProjectName)' == 'Cutroom.Tests'">
    <None Include="$(MSBuildThisFileDirectory)artifacts\native\Cutroom.Engine.Native.dll" Link="Cutroom.Engine.Native.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory).deps\ffmpeg\bin\*.dll;$(MSBuildThisFileDirectory).deps\ffmpeg\bin\ffmpeg.exe;$(MSBuildThisFileDirectory).deps\ffmpeg\bin\ffprobe.exe" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory).deps\whisper\*.dll;$(MSBuildThisFileDirectory).deps\whisper\whisper-cli.exe" Link="whisper\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory).deps\tools\*" Link="tools\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory).deps\fonts\*" Link="fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
